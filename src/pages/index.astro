---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/biji_kopi.webp";
import produk from "../assets/produk_1";
---

<BaseLayout title="Kopi Senja - Freshly Brewed Everyday">
  <!-- Navbar -->
  <header
    class="fixed top-0 left-0 w-full z-50 mix-blend-difference px-6 py-4 flex justify-between items-center"
  >
    <a href="#" class="font-serif text-2xl font-bold tracking-wider text-white"
      >KOPI.SENJA</a
    >
    <nav
      class="hidden md:flex space-x-8 text-sm font-medium tracking-widest uppercase"
    >
      <a href="#about" class="hover:text-[#C89D66] transition-colors">Tentang</a
      >
      <a href="#menu" class="hover:text-[#C89D66] transition-colors"
        >Menu Utama</a
      >
      <a href="#location" class="hover:text-[#C89D66] transition-colors"
        >Lokasi</a
      >
    </nav>
  </header>

  <!-- Hero Section -->
  <section
    class="relative h-screen flex items-center justify-center overflow-hidden px-4"
  >
    <div class="text-center z-10 max-w-3xl">
      <h1
        class="hero-title font-serif text-5xl md:text-7xl font-bold mb-6 leading-tight opacity-0 translate-y-8"
      >
        Nikmati Rasa <span class="text-[#C89D66] italic">Kopi Otentik</span> Di Setiap
        Tegukan
      </h1>
      <p
        class="hero-subtitle text-base md:text-xl text-neutral-400 mb-8 opacity-0 translate-y-8"
      >
        Dipetik dari biji kopi pilihan nusantara, diseduh langsung oleh barista
        berpengalaman untuk menemani harimu.
      </p>
      <div class="hero-cta opacity-0 translate-y-8">
        <a
          href="#menu"
          class="inline-block bg-[#C89D66] text-black font-semibold px-8 py-4 rounded-full hover:bg-[#b08752] transition-colors"
        >
          Lihat Menu
        </a>
      </div>
    </div>
  </section>

  <!-- About / Highlight Section (Scroll Animation Target) -->
  <section
    id="about"
    class="py-24 px-6 max-w-6xl mx-auto border-t border-neutral-800"
  >
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal-item opacity-0 translate-y-12">
        <h2 class="font-serif text-3xl md:text-5xl font-bold mb-6">
          Kualitas Biji Terbaik Langsung Dari Petani Lokal
        </h2>
        <p class="text-neutral-400 leading-relaxed mb-4">
          Kami percaya bahwa rasa kopi yang nikmat berawal dari hubungan yang
          adil dengan para petani lokal. Setiap biji kopi disangrai secara
          cermat (*artisan roast*) untuk mengeluarkan cita rasa alami khas tanah
          Indonesia.
        </p>
      </div>
      <div class="reveal-item opacity-0 translate-y-12">
        <div
          class="relative w-full h-[400px] bg-neutral-900 rounded-2xl overflow-hidden flex items-center justify-center border border-neutral-800"
        >
          <span class="text-neutral-600">
            <Image
              src={heroImage} 
              alt="Biji kopi pilihan yang disangrai" 
              class="w-full h-auto object-cover rounded-2xl"
              width={1200}
              height={600}
            />
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Menu Highlights -->
  <section id="menu" class="py-24 px-6 max-w-6xl mx-auto">
    <h2
      class="reveal-item font-serif text-3xl md:text-4xl font-bold text-center mb-16 opacity-0 translate-y-12"
    >
      Menu Favorit Minggu Ini
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        ["Espresso Intenso", "Velvet Latte", "Cold Brew Reserve"].map(
          (menu, i) => (
            <div class="reveal-item bg-neutral-900/50 p-6 rounded-2xl border border-neutral-800 hover:border-[#C89D66]/50 transition-colors opacity-0 translate-y-12">
              <div class="w-full h-48 bg-neutral-800 rounded-xl mb-4 flex items-center justify-center">
                <span class="text-neutral-600 text-sm">
                <Image
                  src={produk} 
                  alt="produk1" 
                  class="w-full h-auto object-cover rounded-2xl"
                  width={1200}
                  height={600}
                />
                </span>
              </div>
              <h3 class="font-serif text-xl font-semibold mb-2">{menu}</h3>
              <p class="text-sm text-neutral-400 mb-4">
                Perpaduan cita rasa manis alami dan *body* yang seimbang.
              </p>
              <span class="text-[#C89D66] font-semibold">Rp 28.000</span>
            </div>
          ),
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Registrasi Plugin GSAP ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Animasi Load Awal untuk Hero Section
    const tl = gsap.timeline();
    tl.to(".hero-title", { opacity: 1, y: 0, duration: 1, ease: "power3.out" })
      .to(
        ".hero-subtitle",
        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
        "-=0.6",
      )
      .to(
        ".hero-cta",
        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
        "-=0.6",
      );

    // 2. Animasi Scroll Reveal untuk elemen-elemen saat digulir
    const revealItems = document.querySelectorAll(".reveal-item");
    revealItems.forEach((item) => {
      gsap.to(item, {
        scrollTrigger: {
          trigger: item,
          start: "top 85%", // Mulai animasi saat elemen mencapai 85% layar dari atas
          toggleActions: "play none none reverse",
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
      });
    });
  });
</script>
