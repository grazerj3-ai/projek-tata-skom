---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#12100E] text-[#E8E3DD] font-sans antialiased selection:bg-[#C89D66] selection:text-black"
  >
    <slot />

    <script>
      import { initSmoothScroll } from "../utils/lenis";

      // Inisialisasi Lenis saat halaman dimuat
      document.addEventListener("DOMContentLoaded", () => {
        initSmoothScroll();
      });
    </script>
  </body>
</html>
